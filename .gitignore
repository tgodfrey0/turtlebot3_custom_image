# Yocto build artifacts (cloned at build time, not committed)
workspace/
poky/
meta-openembedded/
meta-ros/
meta-raspberrypi/
tools/kas-tui/target/
# Generated bitbake config (created from conf/local.conf.template by build.sh)
conf/local.conf

# Machine-local secrets (authkey, wifi/robot passwords) - managed by build.sh
configs/kas/local-overrides.yml

# Cloned upstream layers; custom meta-robot* layers stay tracked
layers/*
!layers/meta-robot
!layers/meta-robot-turtlebot3

# Logs
build-output.log
tui-output.log

# Tool caches
.pixi/

# Build output
build/
tmp/
tmp-glibc/
tmp-luna/

# Download and state cache
downloads/
sstate-cache/

# Rust build artifacts
tools/toml2conf/target/

# Image outputs
*.img
*.img.xz
*.img.bmap
*.wic
*.wic.bmap

# Standard git ignores
*.orig
*.BACKUP.*
*.BASE.*
*.LOCAL.*
*.REMOTE.*
*_BACKUP_*.txt
*_BASE_*.txt
*_LOCAL_*.txt
*_REMOTE_*.txt
*~

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.vsix
.ionide

# Secrets and sensitive files
.env
configs/*.toml
!configs/example.toml

# OS files
.fuse_hidden*
.directory
.Trash-*
.nfs*

# Old Packer artifacts (from previous build system)
.cache/
.packer_cache/
__pycache__/
*.pyc

# Build artifacts from previous system
output/
output-*/
exported-configs/
