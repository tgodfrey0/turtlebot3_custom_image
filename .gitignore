# Yocto build artifacts (cloned at build time, not committed)
workspace/
poky/
meta-openembedded/
meta-ros/
meta-raspberrypi/

# Build output
build/
tmp/
tmp-glibc/
tmp-luna/

# Download and state cache
downloads/
sstate-cache/

# Rust build artifacts
tools/toml2conf/target/

# Image outputs
*.img
*.img.xz
*.img.bmap
*.wic
*.wic.bmap

# Standard git ignores
*.orig
*.BACKUP.*
*.BASE.*
*.LOCAL.*
*.REMOTE.*
*_BACKUP_*.txt
*_BASE_*.txt
*_LOCAL_*.txt
*_REMOTE_*.txt
*~

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.vsix
.ionide

# Secrets and sensitive files
.env
configs/*.toml
!configs/example.toml

# OS files
.fuse_hidden*
.directory
.Trash-*
.nfs*

# Old Packer artifacts (from previous build system)
.cache/
.packer_cache/
__pycache__/
*.pyc

# Build artifacts from previous system
output/
output-*/
