# local.conf.template - Template for Yocto local.conf
#
# This file shows all available configuration options.
# Generate a working local.conf from TOML using:
#   cargo run --manifest-path tools/toml2conf/Cargo.toml -- -i configs/tb_jazzy.toml

# =============================================================================
# MACHINE CONFIGURATION
# =============================================================================
# Raspberry Pi 4 (64-bit)
MACHINE = "raspberrypi4-64"
# Raspberry Pi 5 (64-bit)
# MACHINE = "raspberrypi5"

# =============================================================================
# ROBOT CONFIGURATION
# =============================================================================
# Robot type (generic, turtlebot3, etc.)
ROBOT_TYPE = "turtlebot3"

# Robot model (burger, waffle, etc.)
ROBOT_MODEL = "burger"

# Hostname prefix for auto-generated hostnames (MAC-based)
HOSTNAME_PREFIX = "tb3"

# Command to run at boot (leave empty for no auto-launch)
BRINGUP_COMMAND = "ros2 launch turtlebot3_bringup robot.launch.py"

# =============================================================================
# USER CONFIGURATION
# =============================================================================
# Robot user account
ROBOT_USER = "tb"
ROBOT_PASS = "changeme"

# SSH public key (optional, for key-based auth)
# ROBOT_SSH_KEY = "ssh-rsa AAAA..."

# =============================================================================
# ROS2 CONFIGURATION
# =============================================================================
# Enable ROS2 support (requires meta-ros layers in bblayers.conf)
ROS_ENABLED = "1"

# ROS2 distribution (humble, jazzy, iron, rolling)
ROS_DISTRO = "jazzy"

# ROS domain ID (0-101)
ROS_DOMAIN_ID = "30"

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================
# WiFi networks for first-boot setup (up to 3)
WIFI_SSID_0 = "Robot_Swarm_AP"
WIFI_PASS_0 = "password"

# WIFI_SSID_1 = "SOTON-IoT"
# WIFI_PASS_1 = "password"

# WIFI_SSID_2 = ""
# WIFI_PASS_2 = ""

# =============================================================================
# TAILSCALE VPN
# =============================================================================
# Enable Tailscale VPN (first-boot interactive setup)
TAILSCALE_ENABLED = "1"

# Use robot hostname as Tailscale hostname
TAILSCALE_USE_HOSTNAME = "1"

# =============================================================================
# HARDWARE CONFIGURATION
# =============================================================================
# LIDAR model (LDS-01, LDS-02, LDS-03)
LDS_MODEL = "LDS-02"

# Camera support (1 = enabled, 0 = disabled)
CAMERA_SUPPORT = "1"

# OpenCR motor controller support (1 = enabled, 0 = disabled)
OPENCR_SUPPORT = "1"

# =============================================================================
# BUILD OPTIMIZATION
# =============================================================================
# Download directory (shared across builds)
# DL_DIR = "${TOPDIR}/../downloads"

# Shared state cache (speeds up rebuilds)
# SSTATE_DIR = "${TOPDIR}/../sstate-cache"

# Parallel build settings
# BB_NUMBER_THREADS = "8"
# PARALLEL_MAKE = "-j 8"
